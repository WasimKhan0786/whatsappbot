# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection URI
MONGODB_URI=mongodb://localhost:27017/whatsapp_bot

# WhatsApp Cloud API Credentials
# Obtained from Meta Developer Portal -> WhatsApp -> API Setup
WHATSAPP_TOKEN=EAAB...your_meta_system_user_or_temporary_token...
WHATSAPP_PHONE_NUMBER_ID=100000000000000
WHATSAPP_VERIFY_TOKEN=whatsapp_bot_verify_token_secret_123

# Google Gemini API Key
# Obtained from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Default Allowed Phone Number Filter (international format, digits only or with leading +)
ALLOWED_PHONE_NUMBER=+1234567890

# Chat History & Storage Management
# Max recent messages stored per chat session for Gemini API multi-turn context (default: 20)
CHAT_HISTORY_MAX_MESSAGES=20

# Time-To-Live (TTL) in days to auto-delete inactive chat sessions (default: 7 days)
CHAT_SESSION_TTL_DAYS=7

# Time-To-Live (TTL) in days to auto-delete audit message logs (default: 30 days; 0 = retain indefinitely)
MESSAGE_LOG_TTL_DAYS=30

# Twilio WhatsApp API Configuration
# Obtained from Twilio Console (https://console.twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Hugging Face Inference API Key
HUGGINGFACE_API_KEY=

# World News API Key (https://worldnewsapi.com)
WORLD_NEWS_API_KEY=

# Alert Notification System (WhatsApp / Email)
ALERT_EMAIL_USER=
ALERT_EMAIL_PASS=
ALERT_NOTIFICATION_EMAIL=
ALERT_WHATSAPP_NUMBER=

