{
  "name": "whatsapp-automated-bot",
  "version": "1.0.0",
  "description": "WhatsApp Cloud API & Google Gemini AI Automation Bot with Node.js and React",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build",
    "start": "node server/src/server.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "whatsapp",
    "gemini",
    "express",
    "react",
    "mongodb",
    "webhook"
  ],
  "author": "",
  "license": "ISC"
}
